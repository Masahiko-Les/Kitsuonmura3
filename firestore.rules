rules_version = '2';

// 吃音村のセキュリティルール。
// 住民限定のデータは画面を隠すだけでなく、ここでアクセスを制御する。
// 上限値は src/lib/constants.ts の LIMITS と揃えること。
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- 共通 ----

    // メール確認を必須にするか。開発中は false。
    // 本番前に true にし、.env の NEXT_PUBLIC_REQUIRE_EMAIL_VERIFICATION も true にする。
    function requireEmailVerification() {
      return false;
    }

    function signedIn() {
      return request.auth != null;
    }

    // 住民（ログイン済み、かつ必要ならメール確認済み）
    function isResident() {
      return signedIn()
        && (!requireEmailVerification() || request.auth.token.email_verified == true);
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function str(v, max) {
      return v is string && v.size() <= max;
    }

    // ---- 住民票 users/{uid} ----

    function ageGroups() {
      return ['10代', '20代', '30代', '40代', '50代', '60代以上', '答えない'];
    }

    function profileKeys() {
      return ['nickname', 'ageGroup', 'region', 'job', 'features', 'onset',
              'hardSounds', 'hardWords', 'hardScenes', 'struggles', 'tips',
              'hobbies', 'challenges', 'history',
              'historyReactionCount', 'createdAt', 'updatedAt'];
    }

    // 住民票の本文として正しいか（作成・更新で共通）
    function validProfile(d) {
      return d.keys().hasOnly(profileKeys())
        && d.nickname is string && d.nickname.size() >= 1 && d.nickname.size() <= 20
        && d.ageGroup in ageGroups()
        && str(d.region, 200) && str(d.job, 200) && str(d.features, 200)
        && str(d.onset, 200) && str(d.hardSounds, 200) && str(d.hardWords, 200)
        && str(d.hardScenes, 200) && str(d.hobbies, 200) && str(d.challenges, 200)
        && str(d.struggles, 2000) && str(d.tips, 2000)
        && str(d.history, 10000);
    }

    match /users/{uid} {
      allow read: if isResident();

      // 新規登録。共感の件数は0から始まる。メール確認前でも作れる
      allow create: if isSelf(uid)
        && validProfile(request.resource.data)
        && request.resource.data.historyReactionCount == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // 本人による編集。共感の件数と登録日は変えられない
      allow update: if isSelf(uid) && isResident()
        && validProfile(request.resource.data)
        && request.resource.data.historyReactionCount == resource.data.historyReactionCount
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      // ほかの住民が吃音史に共感したとき、件数だけを±1する
      allow update: if isResident() && !isSelf(uid)
        && reactionCountChange('history', uid, 'historyReactionCount');

      // 退会は今回作らない
      allow delete: if false;
    }

    // ---- 共感 reactions/{targetType_targetId_uid} ----
    // 共感ボタンを押すと、reactions の作成と対象の件数+1を同じトランザクションで行う。
    // 取り消すと、reactions の削除と件数-1を同じトランザクションで行う。
    // 両側のルールで getAfter / existsAfter を使い、片方だけの書き込みを拒否する。

    function docPath(rel) {
      return path('/databases/' + database + '/documents/' + rel);
    }

    function reactionTypes() {
      return ['post', 'book', 'history'];
    }

    function reactionDoc(type, targetId, uid) {
      return docPath('reactions/' + type + '_' + targetId + '_' + uid);
    }

    // 共感の対象ドキュメント（吃音史は住民票そのもの）
    function targetDoc(type, targetId) {
      return type == 'post' ? docPath('meetingPosts/' + targetId)
        : type == 'book' ? docPath('books/' + targetId)
        : docPath('users/' + targetId);
    }

    function countField(type) {
      return type == 'history' ? 'historyReactionCount' : 'reactionCount';
    }

    // 対象の書き手。吃音史なら住民票の持ち主
    function authorOf(type, targetId) {
      return type == 'history' ? targetId : get(targetDoc(type, targetId)).data.authorUid;
    }

    // 対象側：件数だけが±1され、それに合う reactions の作成・削除が同時に行われているか
    function reactionCountChange(type, targetId, field) {
      let before = resource.data[field];
      let after = request.resource.data[field];
      let r = reactionDoc(type, targetId, request.auth.uid);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([field])
        && ((after == before + 1 && !exists(r) && existsAfter(r))
          || (after == before - 1 && exists(r) && !existsAfter(r)));
    }

    match /reactions/{reactionId} {
      // 自分の共感だけ読める（押したかどうかの確認用）。存在しない場合も確認できるようにする
      allow read: if isResident()
        && (resource == null || resource.data.uid == request.auth.uid);

      allow create: if isResident()
        && request.resource.data.keys().hasOnly(['targetType', 'targetId', 'uid', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.targetType in reactionTypes()
        && request.resource.data.targetId is string
        && reactionId == request.resource.data.targetType + '_' + request.resource.data.targetId + '_' + request.auth.uid
        && request.resource.data.createdAt == request.time
        && exists(targetDoc(request.resource.data.targetType, request.resource.data.targetId))
        // 自分の投稿には共感できない
        && authorOf(request.resource.data.targetType, request.resource.data.targetId) != request.auth.uid
        && getAfter(targetDoc(request.resource.data.targetType, request.resource.data.targetId))
             .data[countField(request.resource.data.targetType)]
           == get(targetDoc(request.resource.data.targetType, request.resource.data.targetId))
             .data[countField(request.resource.data.targetType)] + 1;

      // 取り消し。対象が削除済みなら、件数を気にせず消せる
      allow delete: if isResident()
        && resource.data.uid == request.auth.uid
        && (!exists(targetDoc(resource.data.targetType, resource.data.targetId))
          || getAfter(targetDoc(resource.data.targetType, resource.data.targetId))
               .data[countField(resource.data.targetType)]
             == get(targetDoc(resource.data.targetType, resource.data.targetId))
               .data[countField(resource.data.targetType)] - 1);

      allow update: if false;
    }

    // ---- 集会 ----

    // テーマ。ID は月（"2026-11"）。書き込みは管理者のみ。
    // 過去の集会はアーカイブとしてすべて読めるようにするため、削除はできない
    function validTheme(themeId, d) {
      return d.keys().hasOnly(['month', 'title', 'description', 'createdAt'])
        && themeId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && d.month == themeId
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 100
        && str(d.description, 500)
        && d.createdAt is timestamp;
    }

    match /themes/{themeId} {
      allow read: if isResident();
      allow create: if isAdmin() && validTheme(themeId, request.resource.data)
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin() && validTheme(themeId, request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    // 今月のテーマがどれか（currentThemeId）。テーマを追加するとき管理者が同じ書き込みで更新する
    match /config/meeting {
      allow read: if isResident();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['currentThemeId'])
        && request.resource.data.currentThemeId is string
        && existsAfter(docPath('themes/' + request.resource.data.currentThemeId));
      allow delete: if false;
    }

    function postKeys() {
      return ['themeId', 'authorUid', 'authorNickname', 'authorAgeGroup', 'text', 'reactionCount', 'createdAt'];
    }

    // 投稿に複製している書き手のニックネーム・年代が、住民票と一致しているか。
    // 住民票の編集と同じ書き込みで投稿側も直すので getAfter で比べる
    function authorMatches(d) {
      let u = getAfter(docPath('users/' + request.auth.uid)).data;
      return d.authorNickname == u.nickname && d.authorAgeGroup == u.ageGroup;
    }

    match /meetingPosts/{postId} {
      allow read: if isResident();

      // 投稿できるのは今月のテーマだけ。本文は5,000字まで
      allow create: if isResident()
        && request.resource.data.keys().hasOnly(postKeys())
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.themeId == get(docPath('config/meeting')).data.currentThemeId
        && request.resource.data.text is string
        && request.resource.data.text.size() >= 1
        && request.resource.data.text.size() <= 5000
        && request.resource.data.reactionCount == 0
        && request.resource.data.createdAt == request.time
        && authorMatches(request.resource.data);

      // 書き手本人：ニックネーム・年代を変えたときに、複製した名前だけを直せる（本文は編集しない）
      allow update: if isResident()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorNickname', 'authorAgeGroup'])
        && authorMatches(request.resource.data);

      // ほかの住民：共感の件数だけを±1
      allow update: if isResident()
        && resource.data.authorUid != request.auth.uid
        && reactionCountChange('post', postId, 'reactionCount');

      allow delete: if isResident() && resource.data.authorUid == request.auth.uid;
    }

    // ---- 図書館 books/{bookId} ----

    function bookTags() {
      return ['吃音', '勇気', '孤独', '仕事', '人生の意味', '自己理解', '夢・挑戦'];
    }

    function bookKeys() {
      return ['authorUid', 'authorNickname', 'authorAgeGroup', 'title', 'bookAuthor', 'tag',
              'struggle', 'encounter', 'words', 'thought', 'change', 'reactionCount', 'createdAt'];
    }

    match /books/{bookId} {
      allow read: if isResident();

      // 書名は必須。5つの問いはどれも任意で、各2,000字まで
      allow create: if isResident()
        && request.resource.data.keys().hasOnly(bookKeys())
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 1
        && request.resource.data.title.size() <= 60
        && str(request.resource.data.bookAuthor, 40)
        && request.resource.data.tag in bookTags()
        && str(request.resource.data.struggle, 2000)
        && str(request.resource.data.encounter, 2000)
        && str(request.resource.data.words, 2000)
        && str(request.resource.data.thought, 2000)
        && str(request.resource.data.change, 2000)
        && request.resource.data.reactionCount == 0
        && request.resource.data.createdAt == request.time
        && authorMatches(request.resource.data);

      // 書き手本人：複製した名前だけを直せる
      allow update: if isResident()
        && resource.data.authorUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['authorNickname', 'authorAgeGroup'])
        && authorMatches(request.resource.data);

      // ほかの住民：共感の件数だけを±1
      allow update: if isResident()
        && resource.data.authorUid != request.auth.uid
        && reactionCountChange('book', bookId, 'reactionCount');

      allow delete: if isResident() && resource.data.authorUid == request.auth.uid;
    }

    // ここに書かれていないものは、すべて読み書きできない
  }
}
