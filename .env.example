# Firebase コンソール > プロジェクトの設定 > マイアプリ（ウェブアプリ）の値を入れる。
# このファイルをコピーして .env.local を作る（.env.local はコミットしない）。
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# 公開URL（canonical / OGP 用）。未設定なら https://kitsuonmura.com
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# true にすると Firebase Emulator（Auth: 9099 / Firestore: 8080）に接続する
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=false

# メール確認を必須にするか。開発中は false（登録してすぐ使える）。
# 本番前に true にし、firestore.rules の requireEmailVerification() も true にする。
NEXT_PUBLIC_REQUIRE_EMAIL_VERIFICATION=false
